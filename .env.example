# Application
APP_NAME=Tanilink
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/tanilink_db

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Storage (local)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=3
